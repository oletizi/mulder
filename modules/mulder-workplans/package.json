{
  "name": "@oletizi/mulder-workplans",
  "version": "0.6.0",
  "private": false,
  "description": "Tooling to manage workplan documents for agentic projects",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "mulder-workplans": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "echo \"No linting yet\" && exit 0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run test && npm run build",
    "release": "mulder-release release"
  },
  "keywords": [
    "workplan",
    "planning",
    "agent",
    "documentation"
  ],
  "author": "Orion Letizi",
  "license": "MIT",
  "devDependencies": {
    "@oletizi/mulder-release": "^0.1.6",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@oletizi/mulder-specs": "^0.6.0",
    "commander": "^12.0.0"
  }
}
