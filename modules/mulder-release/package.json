{
  "name": "@oletizi/mulder-release",
  "version": "0.1.6",
  "private": false,
  "description": "Tooling to support cutting releases in agentic projects",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "mulder-release": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "echo \"No tests yet\" && exit 0",
    "lint": "echo \"No linting yet\" && exit 0",
    "typecheck": "tsc --noEmit",
    "release": "node dist/cli.js release"
  },
  "keywords": [
    "release",
    "npm",
    "github",
    "version",
    "publish"
  ],
  "author": "Orion Letizi",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/semver": "^7.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "semver": "^7.0.0"
  }
}
